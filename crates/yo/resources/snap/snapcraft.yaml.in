name: yo
title: Yo
base: core24
version: "$RELEASE_VERSION"
summary: The editor that doesn't get in your way
description: |
  Yo is a fast, native code editor built in Rust with a GPU-accelerated
  renderer. It pairs the speed of a native app with the familiarity of
  VS Code and stays out of your way.
grade: stable
confinement: classic
compression: lzo
website: https://yo.lurenyang.com/
source-code: https://github.com/magalab/yo
issues: https://github.com/magalab/yo/issues
contact: https://github.com/magalab/yo/issues

parts:
  yo:
    plugin: dump
    source: "https://github.com/magalab/yo/releases/download/v$RELEASE_VERSION/yo-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Yo exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Yo exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  yo:
    command: usr/bin/yo
    common-id: me.farshed.Yo
    environment:
      ZED_BUNDLE_TYPE: snap
